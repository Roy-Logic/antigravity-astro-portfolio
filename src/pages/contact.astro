---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact | Astro Learning Journey" 
  description="Connect with me to talk about static site architectures, component designs, or general frontend development."
>
  <section class="py-8 md:py-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    
    <!-- Info Section (Left column) -->
    <div class="lg:col-span-5 flex flex-col gap-6">
      <div class="glass-panel p-8 rounded-2xl relative overflow-hidden">
        <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-accent/10 blur-xl"></div>
        
        <h1 class="text-3xl font-extrabold font-display text-white">Let's Connect</h1>
        <p class="text-sm text-gray-400 leading-relaxed font-light mt-3">
          Have questions about this Astro template, Tailwind CSS v4, or want to collaborate on static site projects? Drop a message!
        </p>

        <!-- Details -->
        <div class="flex flex-col gap-4 mt-8">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-xs text-gray-500 block">Email Address</span>
              <a href="mailto:hello@astrojourney.dev" class="text-sm text-white hover:text-accent font-medium transition-colors">
                hello@astrojourney.dev
              </a>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <span class="text-xs text-gray-500 block">Workspace Location</span>
              <span class="text-sm text-white font-medium">Remote / Global</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Notice Alert -->
      <div class="glass-panel p-6 rounded-2xl border-l-4 border-l-primary bg-primary/5">
        <h4 class="text-xs font-bold text-primary-light uppercase tracking-wider font-mono">Static Form Integration</h4>
        <p class="text-xs text-gray-400 mt-2 leading-relaxed font-light">
          This site runs entirely as static HTML/CSS. When submitting, a local script intercepts the event, performs mock validations, and displays a success notification entirely client-side.
        </p>
      </div>
    </div>

    <!-- Contact Form (Right column) -->
    <div class="lg:col-span-7">
      <div class="glass-panel p-8 md:p-10 rounded-2xl relative">
        <h2 class="text-2xl font-bold font-display text-white mb-6">Send a Message</h2>
        
        <form id="contact-form" class="flex flex-col gap-5">
          <!-- Name -->
          <div class="flex flex-col gap-1.5">
            <label for="name" class="text-xs font-semibold text-gray-400">Your Name</label>
            <input 
              type="text" 
              id="name" 
              required
              class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-primary focus:bg-white/[0.08] transition-all"
              placeholder="John Doe"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-xs font-semibold text-gray-400">Email Address</label>
            <input 
              type="email" 
              id="email" 
              required
              class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-primary focus:bg-white/[0.08] transition-all"
              placeholder="john@example.com"
            />
          </div>

          <!-- Subject -->
          <div class="flex flex-col gap-1.5">
            <label for="subject" class="text-xs font-semibold text-gray-400">Subject</label>
            <input 
              type="text" 
              id="subject" 
              required
              class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-primary focus:bg-white/[0.08] transition-all"
              placeholder="Let's build something!"
            />
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-xs font-semibold text-gray-400">Message</label>
            <textarea 
              id="message" 
              required
              rows="5"
              class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-primary focus:bg-white/[0.08] transition-all resize-none"
              placeholder="Tell me about your project..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            id="submit-btn"
            class="px-6 py-3.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-primary to-accent hover:opacity-95 text-white transition-opacity shadow-md shadow-primary/10 mt-2 flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Send Message</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </button>
        </form>

        <!-- Success overlay card (hidden initially) -->
        <div 
          id="success-overlay" 
          class="absolute inset-0 bg-[#0c0828]/95 backdrop-blur-md rounded-2xl flex flex-col items-center justify-center text-center p-8 opacity-0 pointer-events-none transition-all duration-300 scale-95"
        >
          <div class="w-16 h-16 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-2">Message Sent!</h3>
          <p class="text-sm text-gray-400 max-w-sm leading-relaxed mb-6 font-light">
            Thank you for reaching out. Your mock request has been submitted and captured successfully.
          </p>
          <button 
            id="reset-form-btn"
            class="px-5 py-2.5 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 border border-white/10 text-white transition-colors"
          >
            Send Another Message
          </button>
        </div>

      </div>
    </div>

  </section>
</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const overlay = document.getElementById('success-overlay');
    const resetBtn = document.getElementById('reset-form-btn');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (!form || !overlay || !resetBtn || !submitBtn) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Visual feedback: disabling submit button and modifying labels
      submitBtn.disabled = true;
      const btnSpan = submitBtn.querySelector('span');
      if (btnSpan) btnSpan.textContent = 'Sending...';

      // Perform a small fake delay to mock network request
      setTimeout(() => {
        // Show success overlay
        overlay.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        overlay.classList.add('opacity-100', 'scale-100');
        
        // Reset button states
        submitBtn.disabled = false;
        if (btnSpan) btnSpan.textContent = 'Send Message';
      }, 1000);
    });

    resetBtn.addEventListener('click', () => {
      // Clear all fields
      form.reset();
      
      // Hide success overlay
      overlay.classList.remove('opacity-100', 'scale-100');
      overlay.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
    });
  }

  // Setup form handling on initial load and page navigations
  document.addEventListener('astro:page-load', setupContactForm);
</script>
