---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Home | Astro Learning Journey" 
  description="Follow my progress learning Astro, Tailwind CSS v4, TypeScript, and modern static site architectures."
>
  <!-- Hero Section -->
  <section class="py-12 md:py-20 flex flex-col items-center text-center gap-6 max-w-3xl mx-auto">
    <!-- Learning Status Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-semibold text-primary-light animate-pulse-slow">
      <span class="w-2 h-2 rounded-full bg-accent"></span>
      Currently Learning: Static Workflows
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold font-display leading-tight tracking-tight text-white mt-2">
      Mastering Modern Web Architecture with 
      <span class="bg-gradient-to-r from-primary via-purple-400 to-accent bg-clip-text text-transparent bg-[size:200%] animate-text-shimmer font-black">
        Astro v5
      </span>
    </h1>

    <!-- Subtitle/Description -->
    <p class="text-lg text-gray-400 max-w-2xl leading-relaxed mt-2 font-light">
      Welcome! This site is my playground for exploring modern static site workflows, CSS-first design systems with Tailwind CSS v4, and clean component architecture.
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-wrap justify-center gap-4 mt-6">
      <a
        href="/projects"
        class="px-6 py-3.5 rounded-2xl text-sm font-semibold bg-gradient-to-r from-primary to-accent text-white shadow-lg shadow-primary/20 hover:opacity-95 transition-opacity"
        id="hero-cta-projects"
      >
        View My Projects
      </a>
      <a
        href="/about"
        class="px-6 py-3.5 rounded-2xl text-sm font-semibold bg-white/5 hover:bg-white/10 border border-white/10 text-white transition-all"
        id="hero-cta-about"
      >
        Read My Story
      </a>
    </div>
  </section>

  <!-- Feature Grid / Key Pillars -->
  <section class="py-12 md:py-16 grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Pillar 1: Astro Components -->
    <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4">
      <div class="w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-2xl font-bold font-mono">
        ✦
      </div>
      <h3 class="text-xl font-bold font-display text-white">Component Architecture</h3>
      <p class="text-sm text-gray-400 leading-relaxed font-light">
        Building UI using Astro's HTML-first components. No runtime JavaScript overhead by default. Pure efficiency.
      </p>
    </div>

    <!-- Pillar 2: Tailwind v4 -->
    <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4">
      <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent text-2xl font-bold font-mono">
        ❖
      </div>
      <h3 class="text-xl font-bold font-display text-white">CSS-First Styling</h3>
      <p class="text-sm text-gray-400 leading-relaxed font-light">
        Harnessing the speed of Tailwind CSS v4. Configured directly in global stylesheets using modern CSS properties.
      </p>
    </div>

    <!-- Pillar 3: Fast Deploy -->
    <div class="glass-panel p-8 rounded-2xl flex flex-col gap-4">
      <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 text-2xl font-bold font-mono">
        ▲
      </div>
      <h3 class="text-xl font-bold font-display text-white">Static Optimization</h3>
      <p class="text-sm text-gray-400 leading-relaxed font-light">
        Compiling directly to optimized HTML, CSS, and assets, ready for direct distribution onto globally-distributed CDNs.
      </p>
    </div>
  </section>

  <!-- Interactive Progress Bar/Journey Overview -->
  <section class="py-12 md:py-16 glass-panel rounded-3xl p-8 md:p-12 mt-6">
    <div class="max-w-xl">
      <h2 class="text-2xl md:text-3xl font-extrabold font-display text-white">The Learning Journey</h2>
      <p class="text-sm text-gray-400 leading-relaxed mt-2 font-light">
        I am systematically moving through the stages of modern web deployment. Here is where this project fits in my progress.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8">
      <div class="border border-white/5 bg-white/2 p-4 rounded-xl">
        <span class="text-xs text-primary font-bold font-mono">STEP 01</span>
        <h4 class="text-sm font-bold text-white mt-1">Astro Setup</h4>
        <span class="inline-block text-[10px] bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-0.5 rounded-full mt-2 font-medium">Completed</span>
      </div>
      <div class="border border-white/5 bg-white/2 p-4 rounded-xl">
        <span class="text-xs text-primary font-bold font-mono">STEP 02</span>
        <h4 class="text-sm font-bold text-white mt-1">Tailwind v4 Config</h4>
        <span class="inline-block text-[10px] bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-0.5 rounded-full mt-2 font-medium">Completed</span>
      </div>
      <div class="border border-white/5 bg-white/2 p-4 rounded-xl">
        <span class="text-xs text-accent font-bold font-mono">STEP 03</span>
        <h4 class="text-sm font-bold text-white mt-1">Routing & Layouts</h4>
        <span class="inline-block text-[10px] bg-primary/20 text-primary border border-primary/30 px-2 py-0.5 rounded-full mt-2 font-medium animate-pulse">In Progress</span>
      </div>
      <div class="border border-white/5 bg-white/2 p-4 rounded-xl">
        <span class="text-xs text-gray-500 font-bold font-mono">STEP 04</span>
        <h4 class="text-sm font-bold text-gray-400 mt-1">Cloudflare Deploy</h4>
        <span class="inline-block text-[10px] bg-white/5 text-gray-500 border border-white/10 px-2 py-0.5 rounded-full mt-2 font-medium">Upcoming</span>
      </div>
    </div>
  </section>
</BaseLayout>
