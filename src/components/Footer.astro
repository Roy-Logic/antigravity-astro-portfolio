---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/5 py-12 px-4 bg-[#05031b]">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Brand / Credits -->
    <div class="text-center md:text-left">
      <p class="text-sm text-gray-400 font-medium">
        &copy; {currentYear} AstroJourney. Built as a learning milestone.
      </p>
      <p class="text-xs text-gray-500 mt-1">
        Designed to explore modern web architectures.
      </p>
    </div>

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap justify-center gap-2">
      <span class="text-[11px] bg-white/5 text-gray-300 px-2.5 py-1 rounded-md border border-white/10 font-mono">
        Astro v5
      </span>
      <span class="text-[11px] bg-white/5 text-gray-300 px-2.5 py-1 rounded-md border border-white/10 font-mono">
        Tailwind CSS v4
      </span>
      <span class="text-[11px] bg-white/5 text-gray-300 px-2.5 py-1 rounded-md border border-white/10 font-mono">
        TypeScript
      </span>
      <span class="text-[11px] bg-white/5 text-gray-300 px-2.5 py-1 rounded-md border border-white/10 font-mono">
        Cloudflare Pages
      </span>
    </div>

    <!-- Socials / Links -->
    <div class="flex items-center gap-4">
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-white transition-colors"
        aria-label="GitHub"
        id="footer-github"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z" clip-rule="evenodd" />
        </svg>
      </a>
      <a
        href="https://twitter.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-white transition-colors"
        aria-label="Twitter"
        id="footer-twitter"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>
      <a
        href="https://linkedin.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-white transition-colors"
        aria-label="LinkedIn"
        id="footer-linkedin"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</footer>
