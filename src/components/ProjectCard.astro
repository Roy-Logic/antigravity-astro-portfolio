---
interface Props {
  title: string;
  description: string;
  tags: string[];
  githubLink: string;
  liveLink?: string;
  gradientFrom?: string;
  gradientTo?: string;
}

const {
  title,
  description,
  tags,
  githubLink,
  liveLink,
  gradientFrom = 'from-violet-500',
  gradientTo = 'to-cyan-400',
} = Astro.props;
---

<div class="glass-panel glass-panel-hover rounded-2xl overflow-hidden flex flex-col h-full group">
  <!-- Card Header Visual (Gradient Placeholder) -->
  <div class={`h-48 bg-gradient-to-br ${gradientFrom} ${gradientTo} relative flex items-center justify-center p-6 overflow-hidden`}>
    <!-- Abstract decorative background shape -->
    <div class="absolute inset-0 bg-black/10 backdrop-blur-[2px]"></div>
    <div class="absolute -bottom-8 -right-8 w-24 h-24 rounded-full bg-white/10 blur-xl group-hover:scale-150 transition-transform duration-500"></div>
    <div class="absolute -top-8 -left-8 w-24 h-24 rounded-full bg-black/20 blur-xl group-hover:scale-150 transition-transform duration-500"></div>
    
    <!-- Large decorative Icon or Title Initial -->
    <span class="text-6xl font-black text-white/20 select-none font-display transform group-hover:scale-110 transition-transform duration-500">
      {title.charAt(0)}
    </span>
  </div>

  <!-- Card Body -->
  <div class="p-6 flex flex-col flex-grow">
    <!-- Title -->
    <h3 class="text-xl font-bold font-display text-white group-hover:text-accent transition-colors duration-200">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-gray-400 text-sm mt-2.5 mb-6 line-clamp-3 leading-relaxed flex-grow">
      {description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {tags.map((tag) => (
        <span class="text-xs bg-white/5 text-gray-300 px-2.5 py-1 rounded-md border border-white/5 font-mono">
          {tag}
        </span>
      ))}
    </div>

    <!-- Actions / Links -->
    <div class="flex items-center gap-3 pt-4 border-t border-white/5 mt-auto">
      <a
        href={githubLink}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 border border-white/10 text-white transition-all"
        id={`project-github-${title.toLowerCase().replace(/\s+/g, '-')}`}
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z" clip-rule="evenodd" />
        </svg>
        Code
      </a>
      {liveLink && (
        <a
          href={liveLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-primary to-accent hover:opacity-90 text-white transition-all shadow-md shadow-primary/10"
          id={`project-live-${title.toLowerCase().replace(/\s+/g, '-')}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Demo
        </a>
      )}
    </div>
  </div>
</div>
